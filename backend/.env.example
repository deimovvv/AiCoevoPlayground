# Coevo Studio — backend environment
# Copy to backend/.env and fill in your keys. NEVER commit the real .env.

# ── Required ────────────────────────────────────────────────
GEMINI_API_KEY=        # Google AI Studio, proyecto de COEVO — scripts, chat, visión, STT, agente. Nunca una key de Monks.
FAL_KEY=               # fal.ai — Nano Banana 2, Kling, Seedance (image + video)
ELEVENLABS_API_KEY=    # ElevenLabs — TTS, Voice Design, voice cloning

# ── Optional ────────────────────────────────────────────────
HEYGEN_API_KEY=        # HeyGen Avatar 4 — talking-photo lip-sync (UGC)
BEEBLE_API_KEY=        # Beeble SwitchX — Video Swap tool
BEEBLE_API_BASE=       # Beeble API base URL (only if non-default)
APIFY_API_KEY=         # Apify — Instagram scraping for Content Analyzer imports
VOICE_ID_ELIAS=        # Optional default ElevenLabs voice id

# Base de datos (infra-v1). Desarrollo: sin esto usa el Postgres de docker-compose.yml.
# DATABASE_URL=postgresql+asyncpg://coevo:coevo@127.0.0.1:5433/coevo_studio
# Producción: DB_PASSWORD y CLOUDFLARE_TUNNEL_TOKEN van en el .env de la RAÍZ del repo (los lee
# docker-compose.prod.yml), no acá. Ver docs/guias/produccion.md.

# Avisos por mail (services/mailer.py). Sin RESEND_API_KEY no se manda nada: se anota en el log.
# RESEND_API_KEY=
# MAIL_FROM=Coevo Studio <studio@coevoagency.com>
# APP_URL=https://app.coevoagency.com
